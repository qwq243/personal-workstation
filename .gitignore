# =====================================================================
# 依赖与构建产物
# =====================================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
.DS_Store

# =====================================================================
# 日志：整个目录都不进版本库
# （前身仓库里这里攒了 25MB 日志、界面截图与一次性排障脚本）
# =====================================================================
logs/

# =====================================================================
# 本机运行时配置与凭据 —— 一律忽略
# =====================================================================
# 边车自己的配置（含本地访问令牌）。仓库里只留带说明的 config.example.json，
# 首次运行会自动生成这一份。
server/config.json
# 敏感凭据：面板令牌、模型 API Key、MinerU 令牌…只在本机躺着
server/credentials.json
server/.server.log
# 兜底：任何名字里带 secret 的 json 都别提交（比逐个列文件名更宽，不会漏）
**/*secret*.json

# 通用凭据 / 会话 / cookie（任何模块都别把它们写进仓库）
.env
.env.*
!.env.example
*.session
*.session-journal
*.pem
*.key
cookies.txt
cookies.json
*.cookies

# 运行时生成的边车自启脚本（由 server/lib/panel.mjs 按 process.execPath 生成）
工作站管家.vbs

# =====================================================================
# 数据目录：整目录忽略，只放行「示例数据」
# =====================================================================
# 先忽略目录内容 —— 不能直接写 server/data/，否则下面的 ! 规则全部失效
# （git 不允许重新包含一个父目录已被排除的文件）
server/data/*
# 放行这三个：说明 + 空结构的看板 / 规划台
!server/data/.gitkeep
!server/data/README.md
!server/data/dashboard.json
!server/data/plan.json
# 校历：这份是示例（school 写的是「示例大学」），换成自己学校的之后也可以进版本库
!server/data/school-calendar.json
# 词单：只放行两份空结构。真用起来之后词表里会有个人内容，其余一律忽略
!server/data/vocab/
server/data/vocab/*
!server/data/vocab/lists.json
!server/data/vocab/progress.json

# =====================================================================
# 个人输入 / 操作残留
# =====================================================================
# 个人学习输入（从照片整理出的词单文本）
单词导入-*.txt
# 本机 sqlite（选课任务那类）
/data/
# 网盘 CLI 的登录探测标记
.quarkclouddrive/
# AI 助手的工作目录残留（会话记忆、探测脚本、含个人信息的截图）
.workbuddy/
