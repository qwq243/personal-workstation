      "searXngUrl": "",
      "searXngCategories": [
        "general"
      ],
      "ollamaUrl": "https://ollama.com",
      "providerConfigs": {},
      "defaultSource": "wiki",
      "maxResults": 10,
      "anyTxt": {
        "enabled": false,
        "endpoint": "http://127.0.0.1:9920/",
